---
import Layout from '../layouts/Layout.astro';
import Projects from '../components/Projects.astro';
import { personalInfo, about, skills, experience } from '../data/portfolio';
import { ui } from '../i18n/translations';
import profilePhoto from "../assets/profilePhoto.png";
import { Image } from "astro:assets";

const currentLang = 'es'; // Cambiar a 'en' en la versión en inglés o usar Astro.params
const t = ui[currentLang as keyof typeof ui];
---

<Layout title={t.meta.title} showSplash={true} lang={currentLang}>
	<main>
		<div class="container mx-auto px-4 pt-20 pb-0 max-w-4xl">
		
		<!-- Hero Section -->
		<section class="hero-section flex flex-col items-start justify-center min-h-[calc(100vh-5rem)] space-y-8">
			<div class="reveal inline-flex items-center gap-2 px-3 py-1 rounded-full border border-white/10 bg-white/5 text-emerald-200 text-sm font-medium backdrop-blur-md">
				<span class="relative flex h-2 w-2">
				  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
				  <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
				</span>
				{t.hero.available}
			</div>
			<h1 class="reveal text-5xl md:text-8xl font-extrabold tracking-tight delay-100 leading-tight">
				<span id="profile-pronoun">{t.hero.iam}</span> <br/>
				<span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-200 via-blue-300 to-purple-300">{personalInfo.name}</span><span id="target-dot" class="text-purple-300">.</span>
			</h1>
			<p class="reveal text-xl text-slate-200 max-w-2xl leading-relaxed delay-200 font-light">
				{personalInfo.role}. {personalInfo.description}
			</p>
			<nav class="reveal flex items-center gap-6 pt-4 delay-300" aria-label="Redes sociales">
				<a href={personalInfo.social.github} target="_blank" rel="noopener noreferrer" class="text-slate-200 hover:text-white transition-all hover:scale-110 flex items-center focus:outline-none focus:ring-2 focus:ring-cyan-400 focus:ring-offset-2 focus:ring-offset-slate-900 rounded-full" aria-label="GitHub">
					<span class="sr-only">GitHub</span>
					<svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path></svg>
				</a>
				<a href={personalInfo.social.linkedin} target="_blank" rel="noopener noreferrer" class="text-slate-200 hover:text-blue-300 transition-all hover:scale-110 flex items-center focus:outline-none focus:ring-2 focus:ring-cyan-400 focus:ring-offset-2 focus:ring-offset-slate-900 rounded-full" aria-label="LinkedIn">
					<span class="sr-only">LinkedIn</span>
					<svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd"></path></svg>
				</a>
				<a href={personalInfo.social.email} class="text-slate-200 hover:text-emerald-300 transition-all hover:scale-110 flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-cyan-400 focus:ring-offset-2 focus:ring-offset-slate-900 rounded-full" aria-label="Email">
					<span class="sr-only">Email</span>
					<svg class="w-9 h-9" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"></path></svg>
				</a>
			</nav>
		</section>

		<!-- Sobre Mí Section -->
		<section id="sobre-mi" class="py-20">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
				<!-- Imagen con efecto Parallax Scroll (se mueve más lento que el resto) -->
				<div class="reveal reveal-left relative group mx-4 md:mx-0">
					<div class="absolute -inset-[5px] blur-sm md:-inset-2 md:blur-xl bg-gradient-to-r from-cyan-500 to-purple-600 rounded-[2rem] opacity-20 group-hover:opacity-40 transition duration-1000 group-hover:duration-200"></div>
					<div class="photo-glow relative rounded-2xl overflow-hidden aspect-square">
						<Image
							src={profilePhoto}
							alt={`Foto de perfil de ${personalInfo.name}`}
							width={800}
							height={800}
							class="object-cover w-full h-full"
						/>
					</div>
				</div>
				
				<div class="reveal reveal-right space-y-6 delay-200">
					<h2 class="text-4xl font-bold flex items-center gap-3 text-white">
						<span class="w-12 h-1 bg-gradient-to-r from-cyan-500 to-blue-500 rounded-full"></span>
						{t.about.title}
					</h2>
					<p class="text-slate-200 text-lg leading-relaxed focus:outline-none focus:text-white transition-colors" tabindex="0">
						{about.description_1}
					</p>
					<p class="text-slate-200 text-lg leading-relaxed focus:outline-none focus:text-white transition-colors" tabindex="0">
						{about.description_2}
					</p>
					
					<!-- Habilidades / Tech Stack -->
					<div class="pt-4">
						<h3 class="text-sm font-bold text-slate-200 mb-4 uppercase tracking-widest">{t.about.stack}</h3>
						<div class="flex flex-wrap gap-3">
							{skills.map((tech) => (
								<span class="tech-badge px-4 py-2 bg-white/5 border border-white/10 rounded-xl text-sm text-slate-200 hover:bg-white/10 hover:border-cyan-500/30 hover:text-cyan-300 transition-all cursor-default">
									{tech}
								</span>
							))}
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Experiencia Section -->
		<section id="experiencia" class="py-20 relative overflow-hidden">
			<!-- Elemento decorativo flotante -->
			<div class="absolute top-1/2 right-0 w-96 h-96 bg-purple-500/10 rounded-full blur-[100px] -z-10 parallax-scroll" data-scroll-speed="0.1"></div>

			<h2 class="reveal text-4xl font-bold mb-16 flex items-center gap-3 text-white">
				<span class="w-12 h-1 bg-gradient-to-r from-blue-500 to-purple-500 rounded-full"></span>
				{t.experience.title}
			</h2>
			<div class="space-y-12 border-l border-white/10 ml-3 pl-12 relative">
				<!-- Línea animada (Tracer) -->
				<div class="absolute left-[-1px] top-0 bottom-0 w-px overflow-hidden">
					<div class="w-full h-40 bg-gradient-to-t from-transparent via-white/10 to-transparent absolute -bottom-40 animate-scan"></div>
				</div>
				{experience.map((job, index) => (
					<article class={`reveal ${index % 2 === 0 ? 'reveal-left' : 'reveal-right'} relative focus:outline-none`} style={`transition-delay: ${index * 100}ms`} tabindex="0">
						<span class="absolute -left-14 top-2 w-4 h-4 rounded-full border border-white/20 bg-slate-950 shadow-[0_0_15px_rgba(59,130,246,0.5)]">
							<span class="absolute inset-0 rounded-full bg-blue-500 opacity-50 animate-ping"></span>
							<span class="absolute inset-0 rounded-full bg-blue-500"></span>
						</span>
						<h3 class="text-2xl font-bold text-white mb-1">{job.title}</h3>
						<div class="flex items-center gap-3 text-sm text-cyan-200 mb-4 font-medium tracking-wide">
							<span>{job.company}</span>
							<span>•</span>
							<span>{job.period}</span>
						</div>
						<p class="text-slate-200 max-w-2xl leading-relaxed">{job.desc}</p>
					</article>
				))}
			</div>
		</section>

		<!-- Proyectos Header -->
		<section id="proyectos" class="pt-20 pb-4">
			<h2 class="reveal text-4xl font-bold mb-6 flex items-center gap-3 text-white">
				<span class="w-12 h-1 bg-gradient-to-r from-emerald-400 to-cyan-400 rounded-full"></span>
				{t.projects.title}
			</h2>
		</section>
		</div>
		
		<Projects />
		
		<footer class="reveal py-10 flex flex-col items-center gap-4 text-slate-300 text-sm">
			<img src="/favicon.svg" alt="Logo" class="w-10 h-10 opacity-50 hover:opacity-100 transition-all duration-300 invert hover:scale-110" />
			<p>&copy; {new Date().getFullYear()} {personalInfo.name}. {t.footer.rights}</p>
		</footer>
	</main>

	<style>
		@keyframes scan {
			0% { bottom: -10rem; }
			40% { bottom: 100%; }
			100% { bottom: 100%; }
		}
		.animate-scan {
			animation: scan 6s linear infinite;
		}
	</style>
</Layout>