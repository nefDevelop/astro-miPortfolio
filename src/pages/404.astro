---
import Layout from '../layouts/Layout.astro';
import { ui } from '../i18n/translations';

// 404 vive fuera de [lang]: un servidor estático sirve el mismo 404.html para
// cualquier URL, así que no hay una versión por idioma que generar. Se
// renderiza en español en el servidor y un script la sube al idioma del
// visitante si este prefiere inglés. Sin JS se queda en español, que es
// siempre una versión válida.
const es = ui.es;
const en = ui.en;
---

<Layout title={`404 — ${es.notFound.title}`} description={es.notFound.desc} lang="es" noindex>
	<section class="mx-auto flex min-h-[60vh] max-w-5xl flex-col justify-center px-5 py-20">
		<p class="meta text-dot">404</p>
		<h1 class="mt-4 text-4xl font-extrabold tracking-tight sm:text-5xl" data-404="title">
			{es.notFound.title}
		</h1>
		<p class="mt-4 max-w-prose text-lg leading-relaxed text-muted" data-404="desc">
			{es.notFound.desc}
		</p>

		<div class="mt-8 flex flex-wrap gap-3">
			<a
				href="/es/"
				aria-label={es.notFound.back}
				data-404-label="notFound.back"
				class="rounded-full bg-ink px-6 py-3 font-medium text-paper ink-btn"
			>
				<span data-404="back">ES</span>
			</a>
			<a
				href="/en/"
				aria-label={es.notFound.back}
				data-404-label="notFound.back"
				class="rounded-full border border-hair px-6 py-3 font-medium wash"
			>
				<span data-404="back">EN</span>
			</a>
		</div>
	</section>

	<script define:vars={{ en }}>
		// El texto en español ya está en el HTML; aquí solo se sustituye si el
		// visitante prefiere inglés. Se marca el lang del documento para que los
		// lectores de pantalla no lean español a un visitante inglés.
		if (!navigator.language.toLowerCase().startsWith('en')) return;
		document.documentElement.lang = 'en';
		for (const el of document.querySelectorAll('[data-404]')) {
			const texto = en.notFound[el.dataset['404']];
			if (texto) el.textContent = texto;
		}
		// Los botones solo dicen ES y EN; el nombre accesible cambia de idioma
		// con el texto visible, no por separado.
		for (const el of document.querySelectorAll('[data-404-label]')) {
			el.setAttribute('aria-label', en.notFound.back);
		}
	</script>
</Layout>