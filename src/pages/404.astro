---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 | Página no encontrada" showSplash={false}>
	<main class="relative flex flex-col items-center justify-center min-h-screen bg-slate-950 overflow-hidden text-center px-4">
		
		<!-- Efectos de fondo (Blobs de luz) -->
		<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-purple-600/20 rounded-full blur-[120px] -z-10"></div>
		<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[400px] bg-cyan-500/10 rounded-full blur-[100px] -z-10"></div>
		
		<!-- Grid decorativo sutil -->
		<div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:3rem_3rem] [mask-image:radial-gradient(ellipse_at_center,black_40%,transparent_70%)] -z-10"></div>

		<div class="relative z-10 space-y-6">
			<h1 class="text-9xl font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-500 to-purple-600 animate-pulse">
				404
			</h1>
			
			<div class="space-y-2">
				<h2 class="text-3xl md:text-4xl font-bold text-white">
					Página no encontrada
				</h2>
				<p class="text-slate-400 text-lg max-w-md mx-auto">
					Parece que te has desviado del camino. La página que buscas no existe o ha sido movida.
				</p>
			</div>

			<div class="pt-8">
				<a href="/" class="inline-flex items-center gap-2 px-8 py-3 bg-white/5 border border-white/10 rounded-full text-white font-medium hover:bg-white/10 hover:border-cyan-500/50 hover:text-cyan-300 transition-all group hover:scale-105 focus:outline-none focus:ring-2 focus:ring-cyan-400 focus:ring-offset-2 focus:ring-offset-slate-900">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
					</svg>
					Volver al inicio
				</a>
			</div>
		</div>
	</main>
</Layout>