---
import onestFont from '../data/Onest.ttf?url';
import profilePhoto from '../assets/profilePhoto.png';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ui, type Locale } from '../i18n/translations';
import { localePath } from '../lib/paths';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	lang: Locale;
	/** Ruta sin el prefijo de idioma ni la barra final, p. ej. '' o 'projects/recipenode' */
	path?: string;
	/** Las páginas de error no deben indexarse */
	noindex?: boolean;
}

const { title, description, lang, path = '', noindex = false } = Astro.props;
const t = ui[lang];

const url = (locale: Locale) => localePath(locale, path);
const canonical = new URL(url(lang), Astro.site);
const ogImage = new URL(profilePhoto.src, Astro.site);

// El favicon es un documento aislado: no hereda currentColor ni la clase
// `dark` de la página, así que se sirven dos archivos con el color de cada
// tema (src/assets/mark.svg es la fuente del trazado). Se usan URLs
// normales y no data URI porque Chrome no revalida los favicons data URI
// al alternar el tema. El script de la <head> y el de Nav eligen la que
// toca; sin JS se dejan los dos <link> con prefers-color-scheme.
const iconLight = '/favicon-light.svg';
const iconDark = '/favicon-dark.svg';
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{/* Sin esto el scrollbar y los widgets nativos se quedan claros en tema
		    oscuro, que es lo que mas delata un tema a medio hacer. */}
		<meta name="color-scheme" content="light dark" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{Object.keys(ui).map((locale) => (
			<link rel="alternate" hreflang={locale} href={new URL(url(locale as Locale), Astro.site)} />
		))}
		<link rel="alternate" hreflang="x-default" href={new URL(url('es'), Astro.site)} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={t.meta.siteName} />
		<meta property="og:locale" content={lang} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />

		{noindex && <meta name="robots" content="noindex" />}
		<meta name="theme-color" content="#f4f0e8" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0e2b22" media="(prefers-color-scheme: dark)" />

		{/* Dos links mientras no haya JS: cada uno cubre una preferencia del
		    sistema. El script de abajo los unifica en el primero (que lleva
		    las dos variantes en data-icon-*) y fija el href del tema activo. */}
		<link
			rel="icon"
			type="image/svg+xml"
			href={iconLight}
			media="(prefers-color-scheme: light)"
			data-icon-light={iconLight}
			data-icon-dark={iconDark}
		/>
		<link rel="icon" type="image/svg+xml" href={iconDark} media="(prefers-color-scheme: dark)" />
		<link rel="preload" href={onestFont} as="font" type="font/ttf" crossorigin />

		<style is:inline set:html={`
			@font-face {
				font-family: 'Onest';
				src: url('${onestFont}') format('truetype');
				font-weight: 100 900;
				font-style: normal;
				font-display: swap;
			}
		`}></style>

		{/* Tema y marca de JS: se ejecutan antes del primer paint para evitar
		    el destello de tema claro y para que el contenido nunca dependa de JS
		    para ser visible. */}
		<script is:inline>
			(function () {
				var stored = localStorage.getItem('theme');
				var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				var isDark = stored === 'dark' || (!stored && prefersDark);
				if (isDark) {
					document.documentElement.classList.add('dark');
				}
				document.documentElement.classList.add('js');

				// Con JS no hace falta el fallback de prefers-color-scheme: se
				// reduce a un solo <link> con el href del tema realmente
				// activo (que puede diferir del sistema si el visitante lo
				// forzó con el botón). El nodo se recrea en vez de mutar su
				// href: al cambiar la href de un <link> ya cargado Chrome no
				// vuelve a rasterizar el icono de la pestaña.
				var icon = document.querySelector('link[data-icon-light]');
				if (icon) {
					var fresh = document.createElement('link');
					fresh.setAttribute('rel', 'icon');
					fresh.setAttribute('type', 'image/svg+xml');
					fresh.setAttribute('data-icon-light', icon.getAttribute('data-icon-light'));
					fresh.setAttribute('data-icon-dark', icon.getAttribute('data-icon-dark'));
					fresh.setAttribute(
						'href',
						isDark
							? icon.getAttribute('data-icon-dark')
							: icon.getAttribute('data-icon-light')
					);
					icon.parentNode.replaceChild(fresh, icon);

					var fallbacks = document.querySelectorAll('link[rel="icon"][media]');
					for (var i = 0; i < fallbacks.length; i++) {
						fallbacks[i].parentNode.removeChild(fallbacks[i]);
					}
				}
			})();
		</script>
	</head>

	<body class="font-['Onest',sans-serif] antialiased">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
		>
			{t.nav.skipToContent}
		</a>

		<Nav lang={lang} />

		{/* Centinela: al salir de pantalla, la cabecera se opaca. Evita un
		    listener de scroll y el coste queutina. */}
		<div id="page-top" aria-hidden="true"></div>

		<main id="main">
			<slot />
		</main>

		<Footer lang={lang} />
	</body>
</html>

<script>
	// Revelado progresivo: `html.js` solo existe si hay JS, así que sin JS el
	// contenido se ve directamente y sin animaciones.
	//
	// El mismo observador dispara el trazado de las marcas de las láminas
	// (`plate-drawn`), que arranca al entrar en pantalla en vez de al cargar.
	const observer = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				entry.target.classList.add('is-in');
				if (entry.target.hasAttribute('data-plate')) entry.target.classList.add('plate-drawn');
				observer.unobserve(entry.target);
			}
		},
		{ threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
	);

	document.querySelectorAll('[data-reveal], [data-plate]').forEach((el) => observer.observe(el));

	// Cabecera: transparente arriba del todo para que la rejilla llegue al
	// borde superior, opaca en cuanto pasa el centinela.
	const sentinel = document.getElementById('page-top');
	if (sentinel) {
		new IntersectionObserver(([entry]) => {
			document.documentElement.classList.toggle('is-scrolled', !entry.isIntersecting);
		}).observe(sentinel);
	}
</script>