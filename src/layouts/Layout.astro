---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Portfolio de Desarrollador de Software" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Onest:wght@100..900&display=swap" rel="stylesheet">
		<title>{title}</title>
		<script is:inline>
			// Script crítico: Se ejecuta inmediatamente para bloquear el scroll automático
			if (history.scrollRestoration) {
				history.scrollRestoration = 'manual';
			}
			// Eliminar hash de la URL para evitar saltos indeseados al cargar
			if (window.location.hash) {
				window.history.replaceState(null, null, ' ');
			}
			window.scrollTo(0, 0);
		</script>
	</head>
	<body class="bg-[#0a0a0a] text-slate-200 font-['Onest',sans-serif] antialiased selection:bg-cyan-500 selection:text-black overflow-x-hidden">
		<div class="fixed top-0 left-0 z-[-2] h-full w-full bg-[#0a0a0a] overflow-hidden">
			<!-- Fondo de puntos (Dot Pattern) -->
			<div class="absolute inset-0 h-full w-full opacity-0 animate-fade-in-dots">
				<div class="absolute inset-0 h-full w-full bg-[radial-gradient(rgba(255,255,255,0.05)_1px,transparent_1px)] [background-size:24px_24px] animate-dots-move"></div>
			</div>
			<div class="absolute top-0 z-[-2] h-screen w-screen bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"></div>
			<!-- Cuadrados grandes decorativos -->
			<div class="absolute -top-40 -left-40 w-[500px] h-[500px] bg-white/5 rounded-[3rem] blur-2xl animate-float-1"></div>
			<div class="absolute -bottom-40 -right-40 w-[500px] h-[500px] bg-white/5 rounded-[3rem] blur-2xl animate-float-2"></div>
		</div>

		<!-- Intro / Splash Screen -->
		<div id="splash" class="fixed inset-0 z-[100] flex items-center justify-center bg-[#0a0a0a] transition-all duration-1000">
			<h1 id="splash-text" class="text-6xl md:text-9xl font-bold text-white tracking-tighter opacity-0 translate-y-10 transition-all duration-1000 ease-out">Hola.</h1>
		</div>

		<slot />

		<style is:global>
			/* Animación Scroll Reveal */
			.reveal {
				opacity: 0;
				transition: all 1s cubic-bezier(0.17, 0.55, 0.55, 1);
			}
			
			/* Direcciones de entrada */
			.reveal:not(.reveal-left):not(.reveal-right) {
				transform: translateY(50px); /* Por defecto: viene de abajo */
			}
			.reveal-left {
				transform: translateX(-100px); /* Viene de la izquierda */
			}
			.reveal-right {
				transform: translateX(100px); /* Viene de la derecha */
			}

			.reveal.active {
				opacity: 1;
				transform: translate(0, 0);
			}

			/* Estilos para Proyectos (Scroll Horizontal / Pin) */
			.project-container {
				position: relative;
				width: 100%;
			}
			.project-sticky {
				position: sticky;
				top: 0;
				height: 100vh;
				width: 100%;
				overflow: hidden;
			}
			.project-slider {
				position: relative;
				height: 100%;
				width: 100%;
			}
			.project-slide {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				opacity: 0;
				will-change: opacity;
			}

			/* Animaciones de fondo */
			@keyframes float1 {
				0% { transform: translate(0, 0) rotate(12deg); }
				33% { transform: translate(30px, 50px) rotate(20deg); }
				66% { transform: translate(-20px, 20px) rotate(0deg); }
				100% { transform: translate(0, 0) rotate(12deg); }
			}
			@keyframes float2 {
				0% { transform: translate(0, 0) rotate(-12deg); }
				33% { transform: translate(-30px, -50px) rotate(-20deg); }
				66% { transform: translate(20px, -20px) rotate(0deg); }
				100% { transform: translate(0, 0) rotate(-12deg); }
			}
			.animate-float-1 {
				animation: float1 20s ease-in-out infinite;
			}
			.animate-float-2 {
				animation: float2 25s ease-in-out infinite;
			}

			@keyframes fadeInDots {
				0% { opacity: 0; transform: scale(1.1); }
				100% { opacity: 1; transform: scale(1); }
			}
			.animate-fade-in-dots {
				animation: fadeInDots 2s ease-out forwards 2.2s; /* Retraso para esperar al splash */
			}

			@keyframes dotsMove {
				0% { background-position: 0 0; }
				100% { background-position: 24px 24px; }
			}
			.animate-dots-move {
				animation: dotsMove 3s linear infinite;
			}
		</style>

		<script>
			const observer = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('active');
					} else {
						// Solo reseteamos la animación si el elemento sale por ABAJO (es decir, si subimos el scroll)
						// Si sale por ARRIBA (ya lo leímos), lo dejamos visible para que no "re-aparezca" molestamente al subir
						if (entry.boundingClientRect.top > 0) {
							entry.target.classList.remove('active');
						}
					}
				});
			}, { threshold: 0.1 });

			// Lógica del Splash Screen y Observador
			document.addEventListener('DOMContentLoaded', () => {
				const splash = document.getElementById('splash');
				const splashText = document.getElementById('splash-text');

				if (!splash || !splashText) return;

				// Detectar idioma del navegador
				const lang = navigator.language.split('-')[0];
				const greetings: Record<string, string> = {
					es: 'Hola.',
					en: 'Hello.',
					fr: 'Bonjour.',
					de: 'Hallo.',
					it: 'Ciao.',
					pt: 'Olá.'
				};
				splashText.innerText = greetings[lang] || 'Hello.';

				// Bloquear scroll durante la intro
				document.body.style.overflow = 'hidden';

				// 1. Entrada del texto "Hola"
				setTimeout(() => {
					splashText.classList.remove('opacity-0', 'translate-y-10');
				}, 200);

				// 2. Salida del Splash y activación de animaciones del contenido
				setTimeout(() => {
					// Calcular posición del título principal para mover el "Hola" allí
					const mainTitle = document.querySelector('h1');
					if (mainTitle) {
						const splashRect = splashText.getBoundingClientRect();
						const mainRect = mainTitle.getBoundingClientRect();
						// Ajustamos la posición restando el transform inicial del .reveal (50px)
						const targetX = mainRect.left - splashRect.left;
						const targetY = mainRect.top - splashRect.top - 50;
						
						splashText.style.transform = `translate(${targetX}px, ${targetY}px) scale(0.8)`;
					}

					splash.style.backgroundColor = 'transparent';
					splash.classList.add('pointer-events-none');
					
					// Iniciamos las animaciones de la página (Hero, etc.) justo cuando se va la cortina
					setTimeout(() => {
						splashText.style.opacity = '0'; // Desvanecer el texto suavemente
						document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
						setTimeout(() => {
							splash.remove(); // Limpiamos el DOM
							document.body.style.overflow = ''; // Reactivar scroll
						}, 1000);
					}, 1000);
				}, 2000);
			});

			// Efecto Parallax Scroll: Mueve elementos verticalmente al hacer scroll
			const parallaxScrolls = document.querySelectorAll<HTMLElement>('.parallax-scroll');
			window.addEventListener('scroll', () => {
				const scrolled = window.pageYOffset;
				parallaxScrolls.forEach((el) => {
					const speed = parseFloat(el.getAttribute('data-scroll-speed') || '0');
					// Movemos el elemento suavemente basado en el scroll
					el.style.transform = `translateY(${scrolled * speed}px)`;
				});
			});

			// Lógica para Proyectos: Scroll Horizontal (Pin)
			function initProjects() {
				const projectContainers = document.querySelectorAll<HTMLElement>('.project-container');
				
				const handleScroll = () => {
					projectContainers.forEach((container) => {
						const slider = container.querySelector<HTMLElement>('.project-slider');
						if (!slider) return;

						const rect = container.getBoundingClientRect();
						const viewportHeight = window.innerHeight;
						const totalScrollDistance = rect.height - viewportHeight;

						if (totalScrollDistance <= 0) return;

						// Calculamos el progreso: 0 al inicio del sticky, 1 al final
						let progress = 0;
						if (rect.top <= 0) {
							progress = Math.abs(rect.top) / totalScrollDistance;
						}
						progress = Math.max(0, Math.min(progress, 1));

						// Lógica de Opacidad (Stacking)
						const slides = slider.querySelectorAll<HTMLElement>('.project-slide');
						const totalSlides = slides.length;
						
						if (totalSlides > 1) {
							const step = 1 / (totalSlides - 1);
							slides.forEach((slide, index) => {
								if (index === 0) {
									slide.style.opacity = '1'; // El primero siempre visible de base
								} else {
									// Calculamos opacidad basada en el progreso del scroll
									const start = (index - 1) * step;
									const end = index * step;
									let opacity = (progress - start) / (end - start);
									opacity = Math.max(0, Math.min(opacity, 1));
									slide.style.opacity = opacity.toString();
								}
							});
						}
					});
				};

				window.addEventListener('scroll', handleScroll, { passive: true });
				window.addEventListener('resize', handleScroll);
				handleScroll(); // Inicializar inmediatamente para ajustar posición
			}

			// Inicializar cuando el DOM esté listo
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initProjects);
			} else {
				initProjects();
			}
		</script>
	</body>
</html>