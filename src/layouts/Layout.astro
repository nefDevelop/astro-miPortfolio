---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Portfolio de Desarrollador de Software" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Onest:wght@100..900&display=swap" rel="stylesheet">
		<title>{title}</title>
		<script is:inline>
			// Script crítico: Se ejecuta inmediatamente para bloquear el scroll automático
			if (history.scrollRestoration) {
				history.scrollRestoration = 'manual';
			}
			// Eliminar hash de la URL para evitar saltos indeseados al cargar
			if (window.location.hash) {
				window.history.replaceState(null, null, ' ');
			}
			window.scrollTo(0, 0);
		</script>
	</head>
	<body class="bg-[#0a0a0a] text-slate-200 font-['Onest',sans-serif] antialiased selection:bg-cyan-500 selection:text-black">
		<div class="fixed top-0 left-0 z-[-2] h-full w-full bg-[#0a0a0a] overflow-hidden">
			<!-- Fondo de puntos (Dot Pattern) -->
			<div class="absolute inset-0 h-full w-full bg-[radial-gradient(rgba(255,255,255,0.05)_1px,transparent_1px)] [background-size:24px_24px]"></div>
			<div class="absolute top-0 z-[-2] h-screen w-screen bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"></div>
			<!-- Fondos Móviles (Blobs animados) -->
			<div class="parallax-bg absolute top-1/4 left-1/4 w-96 h-96" data-speed="0.05">
				<div class="w-full h-full bg-blue-500/10 rounded-full mix-blend-screen filter blur-[128px] animate-blob"></div>
			</div>
			<div class="parallax-bg absolute top-1/3 right-1/4 w-96 h-96" data-speed="0.08">
				<div class="w-full h-full bg-purple-500/10 rounded-full mix-blend-screen filter blur-[128px] animate-blob animation-delay-2000"></div>
			</div>
			<div class="parallax-bg absolute bottom-1/4 left-1/3 w-96 h-96" data-speed="0.06">
				<div class="w-full h-full bg-indigo-500/10 rounded-full mix-blend-screen filter blur-[128px] animate-blob animation-delay-4000"></div>
			</div>
		</div>

		<!-- Intro / Splash Screen -->
		<div id="splash" class="fixed inset-0 z-[100] flex items-center justify-center bg-[#0a0a0a] transition-opacity duration-1000">
			<h1 id="splash-text" class="text-6xl md:text-9xl font-bold text-white tracking-tighter opacity-0 translate-y-10 transition-all duration-1000 ease-out">Hola.</h1>
		</div>

		<slot />

		<style is:global>
			/* Animación de fondo */
			@keyframes blob {
				0% { transform: translate(0px, 0px) scale(1); }
				33% { transform: translate(30px, -50px) scale(1.1); }
				66% { transform: translate(-20px, 20px) scale(0.9); }
				100% { transform: translate(0px, 0px) scale(1); }
			}
			.animate-blob {
				animation: blob 7s infinite;
			}
			.animation-delay-2000 {
				animation-delay: 2s;
			}
			.animation-delay-4000 {
				animation-delay: 4s;
			}
			
			/* Animación Scroll Reveal */
			.reveal {
				opacity: 0;
				transition: all 1s cubic-bezier(0.17, 0.55, 0.55, 1);
			}
			
			/* Direcciones de entrada */
			.reveal:not(.reveal-left):not(.reveal-right) {
				transform: translateY(50px); /* Por defecto: viene de abajo */
			}
			.reveal-left {
				transform: translateX(-100px); /* Viene de la izquierda */
			}
			.reveal-right {
				transform: translateX(100px); /* Viene de la derecha */
			}

			.reveal.active {
				opacity: 1;
				transform: translate(0, 0);
			}
		</style>

		<script>
			const observer = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('active');
					} else {
						// Solo reseteamos la animación si el elemento sale por ABAJO (es decir, si subimos el scroll)
						// Si sale por ARRIBA (ya lo leímos), lo dejamos visible para que no "re-aparezca" molestamente al subir
						if (entry.boundingClientRect.top > 0) {
							entry.target.classList.remove('active');
						}
					}
				});
			}, { threshold: 0.1 });

			// Lógica del Splash Screen y Observador
			document.addEventListener('DOMContentLoaded', () => {
				const splash = document.getElementById('splash');
				const splashText = document.getElementById('splash-text');

				// Detectar idioma del navegador
				const lang = navigator.language.split('-')[0];
				const greetings = {
					es: 'Hola.',
					en: 'Hello.',
					fr: 'Bonjour.',
					de: 'Hallo.',
					it: 'Ciao.',
					pt: 'Olá.'
				};
				splashText.innerText = greetings[lang] || 'Hello.';

				// Bloquear scroll durante la intro
				document.body.style.overflow = 'hidden';

				// 1. Entrada del texto "Hola"
				setTimeout(() => {
					splashText.classList.remove('opacity-0', 'translate-y-10');
				}, 200);

				// 2. Salida del Splash y activación de animaciones del contenido
				setTimeout(() => {
					splashText.classList.add('opacity-0'); // Solo desvanecer, sin moverse
					splash.classList.add('opacity-0', 'pointer-events-none'); // El fondo negro se desvanece
					
					// Iniciamos las animaciones de la página (Hero, etc.) justo cuando se va la cortina
					setTimeout(() => {
						document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
						splash.remove(); // Limpiamos el DOM
						document.body.style.overflow = ''; // Reactivar scroll
					}, 500);
				}, 2000); // Duración total de la intro (2 segundos)
			});

			// Efecto Parallax: Mueve los fondos según la posición del ratón
			document.addEventListener('mousemove', (e) => {
				const { clientX, clientY } = e;
				const centerX = window.innerWidth / 2;
				const centerY = window.innerHeight / 2;

				document.querySelectorAll('.parallax-bg').forEach((el) => {
					const speed = parseFloat(el.getAttribute('data-speed'));
					const x = (clientX - centerX) * speed;
					const y = (clientY - centerY) * speed;
					el.style.transform = `translate(${x}px, ${y}px)`;
				});
			});

			// Efecto Parallax Scroll: Mueve elementos verticalmente al hacer scroll
			window.addEventListener('scroll', () => {
				const scrolled = window.pageYOffset;
				document.querySelectorAll('.parallax-scroll').forEach((el) => {
					const speed = parseFloat(el.getAttribute('data-scroll-speed') || '0');
					// Movemos el elemento suavemente basado en el scroll
					el.style.transform = `translateY(${scrolled * speed}px)`;
				});
			});
		</script>
	</body>
</html>