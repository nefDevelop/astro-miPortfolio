---
import onestFont from '../data/Onest.ttf?url';

interface Props {
	title: string;
	showSplash?: boolean;
}

const { title, showSplash = true } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Portfolio de Desarrollador de Software" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://images.unsplash.com">
		<link rel="preload" href={onestFont} as="font" type="font/ttf" crossorigin />
		<title>{title}</title>
		<style is:inline set:html={`
			@font-face {
				font-family: 'Onest';
				src: url('${onestFont}') format('truetype');
				font-weight: 100 900;
				font-style: normal;
				font-display: swap;
			}
		`}></style>
		<script is:inline>
			// Script crítico: Se ejecuta inmediatamente para bloquear el scroll automático
			if (history.scrollRestoration) {
				history.scrollRestoration = 'manual';
			}
			// Eliminar hash de la URL para evitar saltos indeseados al cargar
			if (window.location.hash) {
				window.history.replaceState(null, null, ' ');
			}
			window.scrollTo(0, 0);
		</script>
		<script is:inline>
			// Decide si mostrar la animación de bienvenida (splash + hero)
			const GREETING_EXPIRATION_MS = 1 * 60 * 1000; // 1 minuto
			const lastGreetingTime = sessionStorage.getItem('greetingTime');
			const now = new Date().getTime();

			if (lastGreetingTime && (now - parseInt(lastGreetingTime, 10) < GREETING_EXPIRATION_MS)) {
				// Si NO ha expirado, preparamos para SALTAR la animación
				window.showGreetingAnimation = false;
				document.documentElement.classList.add('greeting-shown');
			} else {
				// Si ha expirado o es la primera vez, preparamos para MOSTRAR la animación
				window.showGreetingAnimation = true;
				document.documentElement.classList.remove('greeting-shown');
				sessionStorage.setItem('greetingTime', now.toString());
			}
		</script>
		<slot name="head" />
	</head>
	<body class="bg-[#0a0a0a] text-slate-200 font-['Onest',sans-serif] antialiased selection:bg-cyan-500 selection:text-black overflow-x-hidden">
		<div class="fixed top-0 left-0 z-[-2] h-full w-full bg-[#0a0a0a] overflow-hidden" aria-hidden="true">
			<div class="absolute top-0 z-[-2] h-screen w-screen bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"></div>
			<!-- Cuadrados grandes decorativos -->
			<div class="absolute -top-40 -left-40 w-[500px] h-[500px] bg-white/5 rounded-[3rem] blur-2xl animate-float-1"></div>
			<div class="absolute -bottom-40 -right-40 w-[500px] h-[500px] bg-white/5 rounded-[3rem] blur-2xl animate-float-2"></div>
		</div>
		<canvas id="bg-canvas" class="fixed inset-0 z-[-1] w-full h-full" aria-hidden="true"></canvas>

		<!-- Intro / Splash Screen -->
		{showSplash && (
			<div id="splash" class="fixed inset-0 z-[100] flex items-center justify-center bg-[#0a0a0a] transition-all duration-1000" aria-hidden="true">
				<div id="splash-text" class="text-5xl md:text-8xl font-extrabold text-white tracking-tight opacity-0 translate-y-10 transition-all duration-700 ease-out">Hola.</div>
			</div>
		)}

		<slot />

		<style is:global>
			html {
				/* Reserva espacio para la barra de scroll para evitar saltos de layout */
				scrollbar-gutter: stable;
			}

			/* Accesibilidad: Focus Visible Global */
			:focus-visible {
				outline: 2px solid #22d3ee; /* cyan-400 */
				outline-offset: 2px;
			}

			/* Animación Scroll Reveal */
			.reveal {
				opacity: 0;
				transition: all 1s cubic-bezier(0.17, 0.55, 0.55, 1);
			}
			
			/* Direcciones de entrada */
			.reveal:not(.reveal-left):not(.reveal-right) {
				transform: translateY(3rem); /* Por defecto: viene de abajo */
			}
			.reveal-left {
				transform: translateX(-6rem); /* Viene de la izquierda */
			}
			.reveal-right {
				transform: translateX(6rem); /* Viene de la derecha */
			}

			/* Si ya se mostró el saludo, desactivar animación de entrada en Hero */
			.greeting-shown .hero-section .reveal {
				opacity: 1 !important;
				transform: none !important;
				animation: none !important;
				transition: none !important;
			}

			.reveal.active {
				opacity: 1;
				transform: translate(0, 0);
			}

			/* Estilos para Proyectos (Scroll Horizontal / Pin) */
			.project-container {
				position: relative;
				width: 100%;
				overflow-anchor: none; /* Evita advertencias de anclaje de scroll al manipular el layout */
				min-height: 250vh; /* Altura mínima para dar recorrido al scroll en escritorio */
			}
			@media (max-width: 768px) {
				.project-container { 
					margin-top: 3rem;
					min-height: 400vh; /* Mucha más altura en móvil para contrarrestar el scroll rápido (inercia) */
				}
			}
			.project-sticky {
				position: sticky;
				top: 0;
				height: 100vh;
				height: 100dvh; /* Usar altura dinámica del viewport para móviles (evita saltos por la barra de URL) */
				width: 100%;
				overflow: hidden;
			}
			.project-slider {
				position: relative;
				height: 100%;
				width: 100%;
			}
			.project-slide {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				opacity: 0;
				transition: opacity 0.6s ease-in-out;
			}

			@media (max-width: 768px) {
				/* 1. El contenedor principal del slide se convierte en Flex Column */
				.project-slide {
					display: flex !important;
					flex-direction: column !important;
					justify-content: flex-start !important;
					padding-top: 5rem !important; /* Espacio para el header */
				}

				/* 2. La imagen deja de ser absoluta y ocupa un espacio fijo arriba */
				.project-slide img {
					position: relative !important;
					top: auto !important;
					left: auto !important;
					transform: none !important;
					width: 100% !important;
					height: 40vh !important; /* Altura controlada para la imagen */
					min-height: 250px !important;
					flex-shrink: 0 !important;
					border-radius: 0 0 1rem 1rem !important; /* Solo redondear abajo */
					margin-bottom: 2rem !important; /* Espacio entre imagen y texto */
					mask-image: linear-gradient(to top, black calc(100% - 1.5rem), transparent 100%) !important;
				}

				/* 3. El contenedor del texto deja de ser absoluto (inset-0) y fluye debajo */
				.project-slide > div {
					position: relative !important;
					inset: auto !important;
					width: 100% !important;
					height: auto !important;
					padding: 0 1.5rem 2rem 1.5rem !important; /* Padding lateral y inferior */
					justify-content: flex-start !important;
				}

				/* 4. Ajustes internos del texto */
				.project-slide > div > div {
					width: 100% !important;
					margin: 0 !important;
				}
			}

			/* Animaciones de fondo */
			@keyframes float1 {
				0% { transform: translate(0, 0) rotate(12deg); }
				33% { transform: translate(30px, 50px) rotate(20deg); }
				66% { transform: translate(-20px, 20px) rotate(0deg); }
				100% { transform: translate(0, 0) rotate(12deg); }
			}
			@keyframes float2 {
				0% { transform: translate(0, 0) rotate(-12deg); }
				33% { transform: translate(-30px, -50px) rotate(-20deg); }
				66% { transform: translate(20px, -20px) rotate(0deg); }
				100% { transform: translate(0, 0) rotate(-12deg); }
			}
			.animate-float-1 {
				animation: float1 20s ease-in-out infinite;
			}
			.animate-float-2 {
				animation: float2 25s ease-in-out infinite;
			}

			@keyframes fadeInDots {
				0% { opacity: 0; transform: scale(1.1); }
				100% { opacity: 1; transform: scale(1); }
			}
			.animate-fade-in-dots {
				animation: fadeInDots 2s ease-out forwards 2.2s; /* Retraso para esperar al splash */
			}

			@keyframes dotsMove {
				0% { background-position: 0 0; }
				100% { background-position: 1.5rem 1.5rem; }
			}
			.animate-dots-move {
				animation: dotsMove 3s linear infinite;
			}

			@keyframes shake-fill {
				0% { transform: scale(1); color: white; }
				10% { transform: scale(2) translate(-6px); color: #22d3ee; }
				20% { transform: scale(2) translate(6px); color: #22d3ee; }
				30% { transform: scale(2) translate(-6px); color: #d8b4fe; }
				40% { transform: scale(2) translate(6px); color: #d8b4fe; }
				50% { transform: scale(2) translate(-6px); color: #22d3ee; }
				60% { transform: scale(2) translate(6px); color: #22d3ee; }
				70% { transform: scale(2) translate(0); color: #d8b4fe; }
				100% { transform: scale(1); color: #d8b4fe; }
			}
			.dot-anim {
				animation: shake-fill 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
			}

			@property --fill-angle {
				syntax: '<angle>';
				initial-value: 0deg;
				inherits: true;
			}
			@property --start-angle {
				syntax: '<angle>';
				initial-value: 0deg;
				inherits: true;
			}

			/* Animación Badges Tech Stack */
			.tech-badge, .photo-glow {
				position: relative;
				z-index: 0;
				overflow: hidden;
				transition: background-color 0.5s ease-out;
			}
			.tech-badge {
				border-radius: 9999px;
			}
			.photo-glow {
				padding: 2px; /* Grosor del borde */
				border-radius: 1rem; /* Radio por defecto */
			}
			.photo-glow > img {
				border-radius: inherit;
				display: block;
			}
			.tech-badge::before, .photo-glow::before {
				content: '';
				position: absolute;
				z-index: -2;
				left: -50%;
				top: -50%;
				width: 200%;
				height: 200%;
				background-repeat: no-repeat;
				background-position: 0 0;
				background-image: conic-gradient(from var(--start-angle), rgba(120, 119, 198, 1) var(--fill-angle), transparent var(--fill-angle));
				opacity: 0;
				transition: opacity 0.5s ease-out;
			}
			.tech-badge::after, .photo-glow::after {
				content: '';
				position: absolute;
				z-index: -1;
				inset: 2px;
				background: #171717;
				border-radius: inherit;
				opacity: 0;
				transition: opacity 0.5s ease-out;
			}
			.tech-badge:hover, .photo-glow:hover {
				animation: none !important;
				background-color: transparent !important;
			}
			.tech-badge:hover::before, .photo-glow:hover::before {
				opacity: 1;
				transition: opacity 0.1s ease-in;
			}
			.tech-badge:hover::after, .photo-glow:hover::after {
				opacity: 1;
				transition: opacity 0.1s ease-in;
			}
		</style>

		<script>
			declare global {
				interface Window {
					showGreetingAnimation: boolean;
				}
			}

			const observer = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('active');
					} else {
						// Solo reseteamos la animación si el elemento sale por ABAJO (es decir, si subimos el scroll)
						// Si sale por ARRIBA (ya lo leímos), lo dejamos visible para que no "re-aparezca" molestamente al subir
						if (entry.boundingClientRect.top > 0) {
							entry.target.classList.remove('active');
						}
					}
				});
			}, { threshold: 0.1 });

			// Lógica del Splash Screen y Observador
			document.addEventListener('DOMContentLoaded', async () => {
				const splash = document.getElementById('splash');
				const splashText = document.getElementById('splash-text');
				const targetDot = document.getElementById('target-dot');

				// Comprobación para saltar la animación del splash si ya se ha visto
				// La variable `window.showGreetingAnimation` se define en un script en el <head>
				if (window.showGreetingAnimation === false) {
					if (splash) {
						splash.remove();
					}
					document.body.style.overflow = ''; // Habilitar scroll
					// Activar todas las animaciones de scroll-reveal inmediatamente
					document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
					if (targetDot) {
						targetDot.style.opacity = '1';
					}
					return; // Salir para no ejecutar la lógica del splash
				}

				// Lógica del Splash Screen (si no se ha saltado)
				if (!splash || !splashText) return;

				// Detectar idioma del navegador
				const lang = navigator.language.split('-')[0];
				const greetings: Record<string, string> = {
					es: 'Hola.',
					en: 'Hello.',
				};
				const text = greetings[lang] || '\nHello.';
				splashText.innerHTML = `<span id="splash-word" class="inline-block transition-all duration-1000 ease-out">${text.slice(0, -1)}</span><span class="inline-block w-0 overflow-visible"><span id="splash-dot" class="inline-block transition-all duration-1000 ease-out" style="font-family: Arial;">${text.slice(-1)}</span></span>`;

				// Actualizar texto "Soy" -> "I'm" según idioma detectado
				const profilePronoun = document.getElementById('profile-pronoun');
				if (profilePronoun) {
					const pronouns: Record<string, string> = {
						es: 'Soy',
						en: "I'm",
					};
					profilePronoun.textContent = pronouns[lang] || "I'm";
				}

				const splashDot = document.getElementById('splash-dot');

				// Esperar a que las fuentes carguen para cálculos precisos
				await document.fonts.ready;

				// Calcular posición vertical inicial para alinear con el target (movimiento horizontal puro)
				if (targetDot && splashDot) {
					targetDot.style.opacity = '0'; // Ocultar punto destino inicialmente
					// Desactivar transiciones temporalmente para medir y ajustar sin animación
					splashText.style.transition = 'none';
					splashText.classList.remove('translate-y-10');
					splashText.style.marginTop = ''; // Limpiar margen previo para medición correcta
					
					const splashRect = splashDot.getBoundingClientRect();
					const targetRect = targetDot.getBoundingClientRect();
					
					splashText.classList.add('translate-y-10');
					
					const splashCenterY = splashRect.top + splashRect.height / 2;
					const targetCenterY = targetRect.top + targetRect.height / 2;
					
					// Ajuste: Alineamos centros y bajamos 20px extra para corregir la percepción de "muy alto"
					splashText.style.marginTop = `${targetCenterY - splashCenterY + 36}px`;
					
					requestAnimationFrame(() => {
						splashText.style.transition = '';
					});
				}

				// Bloquear scroll durante la intro
				document.body.style.overflow = 'hidden';

				// 1. Entrada del texto "Hola"
				setTimeout(() => {
					splashText.style.transition = ''; // Restaurar transición
					splashText.classList.remove('opacity-0');
					splashText.classList.remove('translate-y-10');
				}, 200);

				// 1.5. Animación del punto (Shake & Fill)
				setTimeout(() => {
					const dot = document.getElementById('splash-dot');
					if (dot) {
						dot.classList.add('dot-anim');
						// Restaurar fuente Onest casi al final de la animación
						setTimeout(() => {
							dot.style.fontFamily = '';
						}, 400);
					}
				}, 900);

				// 2. Salida del Splash y activación de animaciones del contenido
				setTimeout(() => {
					// Calcular posición del título principal para mover el "Hola" allí
					const splashWord = document.getElementById('splash-word');

					if (targetDot && splashDot && splashWord && splash) {
						// Calcular posiciones dinámicamente para alinear el punto matemáticamente
						const splashRect = splashDot.getBoundingClientRect();
						const targetRect = targetDot.getBoundingClientRect();
						const moveX = (targetRect.left + targetRect.width / 2) - (splashRect.left + splashRect.width / 2);
						const moveY = (targetRect.top + targetRect.height / 2) - (splashRect.top + splashRect.height / 2);

						const revealParent = targetDot.closest('.reveal');
						
						// 1. Animar salida del texto hacia la izquierda
						splashDot.classList.remove('dot-anim');
						splashDot.style.color = '#d8b4fe'; // Mantener color final (morado aún más claro)
						
						// El reflow forzado aquí es innecesario con Web Animations API

						// El punto viaja solo hacia su destino (cálculo exacto)
						// Usamos Web Animations API para un rebote complejo (choca, rebota, asienta)
						splashDot.animate([
							// 80% del tiempo es para llegar al destino, acelerando al final para el "choque"
							// FASE 1 (0-5% del tiempo): Aceleración. Recorre el 5% de la distancia.
							{ transform: `translate(${moveX * 0.05}px, ${moveY * 0.05}px)`, easing: 'ease-in', offset: 0.04 },
							// FASE 2 (5-90% del tiempo): Velocidad máxima. Recorre hasta el 95% de la distancia.
							{ transform: `translate(${moveX * 0.95}px, ${moveY * 0.95}px)`, easing: 'linear', offset: 0.72 },
							// FASE 3 (90-100% del tiempo): Intento de frenada. Recorre el 5% final.
							{ transform: `translate(${moveX}px, ${moveY}px)`, easing: 'ease-out', offset: 0.8 },
							// 1er Rebote: Vuelve atrás un 5% de la distancia total
							{ transform: `translate(${moveX * 0.95}px, ${moveY * 0.95}px)`, easing: 'ease-out', offset: 0.9 },
							// 2do Rebote: Se pasa un 1% hacia adelante
							{ transform: `translate(${moveX * 1.01}px, ${moveY * 1.01}px)`, easing: 'ease-in', offset: 0.95 },
							// Asentamiento final en la posición exacta
							{ transform: `translate(${moveX}px, ${moveY}px)`, easing: 'ease-out', offset: 1 }
						], {
							duration: 1000,
							fill: 'forwards' // Mantiene el estado final de la animación
						});

						// La opacidad se anima por separado para desaparecer justo al final
						splashDot.animate([{ opacity: 1, offset: 0.99 }, { opacity: 0, offset: 1 }], {
							duration: 1000,
							fill: 'forwards'
						});
						// El texto se queda en el sitio y se va hacia el fondo
						splashWord.style.transition = 'opacity 0.5s ease-out, transform 1s ease-in';
						splashWord.style.transform = 'scale(0.5)';
						splashWord.style.opacity = '0';

						// 2. Activar el título principal
						if (revealParent) {
							revealParent.classList.add('active');
						}
					} else {
						// Caso 404 o sin target: Simplemente desvanecer el splash
						splash.style.opacity = '0';
					}

					splash.style.backgroundColor = 'transparent';
					splash.classList.add('pointer-events-none');
					
					// Iniciamos las animaciones de la página (Hero, etc.) justo cuando se va la cortina
					setTimeout(() => {
						document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
						if (targetDot) {
							targetDot.style.transition = 'none'; // Asegurar cambio instantáneo
							targetDot.style.opacity = '1'; // Mostrar el punto real debajo del splash
						}
						setTimeout(() => {
							splash.remove(); // Limpiamos el DOM
							document.body.style.overflow = ''; // Reactivar scroll
							// Forzar actualización de proyectos por si acaso
							window.dispatchEvent(new Event('scroll'));
						}, 1000);
					}, 1000);
				}, 2000);
			});

			// Efecto Parallax Scroll: Mueve elementos verticalmente al hacer scroll
			const parallaxScrolls = document.querySelectorAll<HTMLElement>('.parallax-scroll');
			let parallaxTicking = false;
			window.addEventListener('scroll', () => {
				if (!parallaxTicking) {
					window.requestAnimationFrame(() => {
						const scrolled = window.pageYOffset;
						parallaxScrolls.forEach((el) => {
							const speed = parseFloat(el.getAttribute('data-scroll-speed') || '0');
							el.style.transform = `translateY(${scrolled * speed}px)`;
						});
						parallaxTicking = false;
					});
					parallaxTicking = true;
				}
			}, { passive: true });

			// Lógica para Proyectos: Scroll Horizontal (Pin)
			function initProjects() {
				const projectContainers = document.querySelectorAll('.project-container');
				let ticking = false;

				// Configurar navegación por teclado (Tab) para los slides
				projectContainers.forEach((container) => {
					const slider = container.querySelector('.project-slider');
					if (!slider) return;
					const slides = slider.querySelectorAll('.project-slide');
					const totalSlides = slides.length;

					slides.forEach((slide, index) => {
						slide.setAttribute('tabindex', '0');
						slide.addEventListener('focus', () => {
							const rect = container.getBoundingClientRect();
							const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
							const absoluteContainerTop = rect.top + scrollTop;
							const totalScrollDistance = (container as HTMLElement).offsetHeight - window.innerHeight;

							if (totalSlides > 1 && totalScrollDistance > 0) {
								const progress = index / (totalSlides - 1);
								const targetScroll = absoluteContainerTop + (progress * totalScrollDistance);
								window.scrollTo({ top: targetScroll, behavior: 'smooth' });
							}
						});
					});
				});
				
				const handleScroll = () => {
					if (!ticking) {
						window.requestAnimationFrame(() => {
							const viewportHeight = window.innerHeight;
							
							// Fase 1: Lectura (Reads) - Agrupamos las mediciones para evitar reflows
							const updates: { slider: Element; progress: number }[] = [];
							projectContainers.forEach((container) => {
								const slider = container.querySelector('.project-slider');
								if (!slider) return;

								const rect = container.getBoundingClientRect();
								const totalScrollDistance = rect.height - viewportHeight;

								if (totalScrollDistance <= 0) return;

								let progress = 0;
								if (rect.top <= 0) {
									progress = Math.abs(rect.top) / totalScrollDistance;
								}
								progress = Math.max(0, Math.min(progress, 1));
								updates.push({ slider, progress });
							});

							// Fase 2: Escritura (Writes) - Aplicamos estilos en lote
							updates.forEach(({ slider, progress }) => {
								const slides = slider.querySelectorAll<HTMLElement>('.project-slide');
								const totalSlides = slides.length;
								
								if (totalSlides > 1) {
									const totalSteps = totalSlides - 1;
									const activeIndex = Math.round(progress * totalSteps);

									slides.forEach((slide, index) => {
										const isActive = index === activeIndex;
										const newOpacity = isActive ? '1' : '0';
										const newPointerEvents = isActive ? 'auto' : 'none';
										
										// Solo escribir si el valor cambia
										if (slide.style.opacity !== newOpacity) {
											slide.style.opacity = newOpacity;
											slide.style.pointerEvents = newPointerEvents;
										}
									});
								}
							});
							
							ticking = false;
						});
						ticking = true;
					}
				};

				window.addEventListener('scroll', handleScroll, { passive: true });
				window.addEventListener('resize', handleScroll);
				window.addEventListener('load', handleScroll); // Asegurar cálculo tras carga completa
				handleScroll(); // Inicializar inmediatamente para ajustar posición
			}

			// Inicializar Badges Tech Stack (Cálculo de ángulo de entrada)
			function initTechBadges() {
				const badges = document.querySelectorAll('.tech-badge, .photo-glow');
				badges.forEach((badge) => {
					let animation: Animation | undefined;
					badge.addEventListener('mouseenter', (e) => {
						const rect = badge.getBoundingClientRect();
						const x = (e as MouseEvent).clientX - (rect.left + rect.width / 2);
						const y = (e as MouseEvent).clientY - (rect.top + rect.height / 2);
						// Calcular ángulo y ajustar para que 0deg sea arriba (CSS conic-gradient standard)
						const deg = Math.atan2(y, x) * (180 / Math.PI) + 90;
						(badge as HTMLElement).style.setProperty('--start-angle', `${deg}deg`);

						// Reiniciar animación de llenado desde 0
						if (animation) animation.cancel();
						animation = (badge as HTMLElement).animate(
							{ '--fill-angle': ['0deg', '360deg'] },
							{ duration: 1000, easing: 'ease-out', fill: 'forwards' }
						);
					});
				});
			}

			// Inicializar cuando el DOM esté listo
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initProjects);
				document.addEventListener('DOMContentLoaded', initTechBadges);
			} else {
				initProjects();
				initTechBadges();
			}

			// Background Animation (Dots & Tracers)
			const canvas = document.getElementById('bg-canvas') as HTMLCanvasElement;
			if (canvas) {
				const ctx = canvas.getContext('2d') as CanvasRenderingContext2D;
				
				let width = 0;
				let height = 0;
				let scrollY = 0;
				let dots: {x: number, y: number}[] = [];
				
				// Configuración
				const DOT_SPACING = 30;
				const LINE_SPEED = 2;
				
				class Tracer {
					x: number;
					y: number;
					targetX: number;
					targetY: number;
					dirX: number;
					dirY: number;
					color: string;
					history: {x: number, y: number}[];
					maxHistory: number;

					constructor(color: string) {
						this.color = color;
						this.x = 0;
						this.y = 0;
						this.targetX = 0;
						this.targetY = 0;
						this.dirX = 0;
						this.dirY = 0;
						this.history = [];
						this.maxHistory = 15;
						this.reset();
					}
					
					reset() {
						// Lógica para aparecer solo en laterales en pantallas grandes (evitar centro)
						const contentWidth = 900;
						const sideMargin = (width - contentWidth) / 2;
						
						if (width > 1024 && sideMargin > DOT_SPACING) {
							const validX = [];
							for (let x = 0; x < width; x += DOT_SPACING) {
								if (x < sideMargin || x > width - sideMargin) validX.push(x);
							}
							this.x = validX.length > 0 ? validX[Math.floor(Math.random() * validX.length)] : Math.floor(Math.random() * (width / DOT_SPACING)) * DOT_SPACING;
						} else {
							this.x = Math.floor(Math.random() * (width / DOT_SPACING)) * DOT_SPACING;
						}
						this.y = Math.floor(Math.random() * (height / DOT_SPACING)) * DOT_SPACING;
						this.targetX = this.x;
						this.targetY = this.y;
						this.dirX = 0;
						this.dirY = 0;
						this.history = [];
						this.maxHistory = 15;
					}
					
					update() {
						const dx = this.targetX - this.x;
						const dy = this.targetY - this.y;
						const dist = Math.sqrt(dx * dx + dy * dy);
						
						if (dist < LINE_SPEED) {
							this.x = this.targetX;
							this.y = this.targetY;
							
							this.history.push({x: this.x, y: this.y});
							if (this.history.length > this.maxHistory) this.history.shift();
							
							const directions = [
								{dx: DOT_SPACING, dy: 0},
								{dx: -DOT_SPACING, dy: 0},
								{dx: 0, dy: DOT_SPACING},
								{dx: 0, dy: -DOT_SPACING}
							];
							
							// Filtrar dirección opuesta para evitar giros de 180 grados
							const validDirections = directions.filter(d => 
								this.dirX === 0 && this.dirY === 0 ? true : !(d.dx === -this.dirX && d.dy === -this.dirY)
							);

							// Intentar encontrar una dirección válida
							let validDir = false;
							let attempts = 0;
							while (!validDir && attempts < 10) {
								let dir;
								// 80% de probabilidad de mantener la dirección (inercia) para hacerlas más directas
								if ((this.dirX !== 0 || this.dirY !== 0) && Math.random() < 0.8) {
									dir = { dx: this.dirX, dy: this.dirY };
								} else {
									dir = validDirections[Math.floor(Math.random() * validDirections.length)];
								}

								const nextX = this.x + dir.dx;
								const nextY = this.y + dir.dy;
								
								// Lógica de colisión: Bordes de pantalla y "zona segura" central
								let isValid = nextX >= 0 && nextX <= width && nextY >= 0 && nextY <= height;
								
								if (isValid && width > 1024) {
									const contentWidth = 900;
									const sideMargin = (width - contentWidth) / 2;
									// Si intenta entrar en la zona central, lo consideramos un muro
									if (nextX > sideMargin && nextX < width - sideMargin) isValid = false;
								}

								if (isValid) {
									this.targetX = nextX;
									this.targetY = nextY;
									this.dirX = dir.dx;
									this.dirY = dir.dy;
									validDir = true;
								} else {
									this.dirX = 0;
									this.dirY = 0;
								}
								attempts++;
							}
						} else {
							this.x += (dx / dist) * LINE_SPEED;
							this.y += (dy / dist) * LINE_SPEED;
						}
					}
					
					draw(ctx: CanvasRenderingContext2D, mapY: (y: number) => number) {
						ctx.beginPath();
						const allPoints = [...this.history, {x: this.x, y: this.y}];
						
						if (allPoints.length > 0) {
							const startY = mapY(allPoints[0].y);
							ctx.moveTo(allPoints[0].x, startY);
							
							for (let i = 1; i < allPoints.length; i++) {
								const currY = mapY(allPoints[i].y);
								const prevY = mapY(allPoints[i-1].y);
								
								// Si la distancia es muy grande, es porque hubo un salto por el wrapping (paralaje infinito)
								if (Math.abs(currY - prevY) > height / 2) {
									ctx.moveTo(allPoints[i].x, currY);
								} else {
									ctx.lineTo(allPoints[i].x, currY);
								}
							}
						}
						
						ctx.strokeStyle = this.color;
						ctx.lineWidth = 2;
						ctx.lineCap = 'round';
						ctx.lineJoin = 'round';
						ctx.shadowColor = this.color;
						ctx.shadowBlur = 8;
						ctx.stroke();
						ctx.shadowBlur = 0;
					}
				}

				let tracers: Tracer[] = [];

				function resize() {
					width = window.innerWidth;
					height = window.innerHeight;
					canvas.width = width;
					canvas.height = height;
					
					dots = [];
					for (let x = 0; x < width; x += DOT_SPACING) {
						for (let y = 0; y < height; y += DOT_SPACING) {
							dots.push({x, y});
						}
					}
				}

				function init() {
					resize();
					window.addEventListener('resize', resize);
					window.addEventListener('scroll', () => scrollY = window.scrollY);
					
					tracers = [
						new Tracer('#1e293b'), // Slate 800 (Gris más oscuro)
						new Tracer('#0f172a')  // Slate 900 (Casi negro)
					];
					
					animate();
				}

				function animate() {
					ctx.clearRect(0, 0, width, height);

					// Función para mapear Y con paralaje y wrapping infinito
					const parallaxSpeed = 0.2;
					const getScreenY = (y: number) => {
						let sy = (y - scrollY * parallaxSpeed) % height;
						if (sy < 0) sy += height;
						return sy;
					};
					
					// Dibujar puntos
					ctx.fillStyle = 'rgba(255, 255, 255, 0.05)';
					ctx.beginPath();
					dots.forEach(dot => {
						ctx.rect(dot.x, getScreenY(dot.y), 2, 2);
					});
					ctx.fill();
					
					tracers.forEach(tracer => {
						tracer.update();
						tracer.draw(ctx, getScreenY);
					});
					
					requestAnimationFrame(animate);
				}

				init();
			}
		</script>
	</body>
</html>