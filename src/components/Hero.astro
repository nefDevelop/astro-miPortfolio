---
import { ui, type Locale } from '../i18n/translations';
import { personalInfo, positioning } from '../data/portfolio';
import HeroGrid from './HeroGrid.astro';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<section class="relative isolate">
	<HeroGrid />

	<div class="mx-auto max-w-5xl px-5 pb-24 pt-16 sm:pb-28 sm:pt-24">
		<p class="meta flex items-center gap-2.5">
			<span class="h-1.5 w-1.5 rounded-full bg-dot"></span>
			{t.hero.available}
		</p>

		<h1
			class="mt-7 text-6xl font-extrabold tracking-tight sm:text-7xl md:text-8xl lg:text-[7rem] lg:leading-[0.95]"
		>
			{personalInfo.name}<span class="relative inline-block"
				><span class="dot-land text-dot">.</span>
				{/* Plataforma de aterrizaje: se enciende en el mismo instante que el punto
				    termina su vuelo, para que la rejilla lea como el sistema del que
				    el punto forma parte.
				    Es un SVG con `shape-rendering="crispEdges"` y geometría entera: con
				    líneas de 1px hechas con bordes CSS y posicionadas en fracciones de
				    píxel, el navegador las difuminaba a 100% y el conjunto parecía un
				    cuadrado borroso. El SVG desactiva el suavizado y las mantiene duras. */}
				<span
					class="landing-pad pointer-events-none absolute bottom-[2px] left-6 hidden text-dot lg:block"
					aria-hidden="true"
				>
					<svg
						width="14"
						height="14"
						viewBox="0 0 14 14"
						fill="none"
						stroke="currentColor"
						stroke-width="1"
						shape-rendering="crispEdges"
					>
						<path d="M0 7h14M7 0v14" />
						<rect x="4" y="4" width="6" height="6" />
					</svg>
				</span>
			</span>
		</h1>

		<p class="mt-8 max-w-2xl text-2xl font-medium tracking-tight sm:text-3xl" data-nav-label={t.nav.label.role}>
			{t.hero.role}
		</p>

		<p class="mt-4 font-mono text-xs uppercase tracking-[0.18em] text-muted sm:text-sm">
			{positioning.stack.join(' · ')}
		</p>

		<p class="mt-6 max-w-prose text-lg leading-relaxed text-muted">{t.hero.goal}</p>

		<div class="mt-9 flex flex-wrap items-center gap-3">
			<a
				href="#proyectos"
				class="rounded-full bg-ink px-6 py-3 font-medium text-paper ink-btn"
			>
				{t.hero.ctaProjects}
			</a>
			<a
				href={`mailto:${personalInfo.email}`}
				class="rounded-full border border-hair px-6 py-3 font-medium wash"
			>
				{t.hero.ctaContact}
			</a>
		</div>
	</div>
</section>