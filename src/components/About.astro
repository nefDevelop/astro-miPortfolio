---
import { Image } from 'astro:assets';
import profilePhoto from '../assets/profilePhoto.png';
import { ui, type Locale } from '../i18n/translations';
import { about, skillGroups, personalInfo } from '../data/portfolio';
import PlateMarks from './PlateMarks.astro';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];
const texto = about[lang];

// Las etiquetas de grupo se traducen; los items no, porque "Docker" es igual
// en los dos idiomas y vive en portfolio.ts.
const etiquetas: Record<string, string> = {
	langs: t.about.stackLabels.langs,
	frontend: t.about.stackLabels.frontend,
	data: t.about.stackLabels.data,
	ops: t.about.stackLabels.ops,
};
const grupos = skillGroups.map((grupo) => ({ label: etiquetas[grupo.key] ?? grupo.key, items: grupo.items }));
const idiomas = [...t.about.languages.items];
---

<section id="sobre-mi" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-20">
	<div class="grid gap-10 md:grid-cols-[minmax(0,17rem)_1fr] md:gap-16">
		{/* En móvil la foto a todo el ancho (~335px) hacía que la cara dominara la
		    pantalla: el ancho queda clampado a 11rem y centrada, y en md recupera
		    la columna de 17rem. El tope de vh sigue por debajo, por si la
		    ventana es muy baja. */}
		<figure
			class="relative mx-auto max-w-[11rem] border border-hair bg-surface p-2 md:sticky md:top-24 md:max-w-none md:self-start"
			data-reveal
			data-plate
		>
			<PlateMarks seed={3} />
			<Image
				src={profilePhoto}
				alt={`Foto de ${personalInfo.fullName}`}
				width={800}
				height={1000}
				{/* max-height clamp la altura que da el aspecto y object-cover
				    recorta por dentro; el anclaje al 40% deja holgura arriba para
				    que el recorte no llegue al pelo. */}
				class="aspect-[4/5] max-h-[45vh] w-full object-cover object-[center_40%]"
			/>
		</figure>

		<div data-reveal>
			<h2 class="meta text-dot" data-nav-label={t.nav.label.about}>{t.about.title}</h2>
			<p class="mt-4 max-w-prose text-xl leading-relaxed">{texto.description_1}</p>
			<p class="mt-4 max-w-prose leading-relaxed text-muted">{texto.description_2}</p>

			<h3 class="meta mt-10">{t.about.stack}</h3>
			<div class="mt-4 space-y-5">
				{
					grupos.map((grupo) => (
						<div>
							<p class="meta">{grupo.label}</p>
							<ul class="mt-2 flex flex-wrap gap-2">
								{grupo.items.map((skill) => (
									<li class="chip rounded-full border border-hair px-3 py-1.5 font-mono text-xs uppercase tracking-widest text-muted">
										{skill}
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>

			<h3 class="meta mt-10">{t.about.languages.title}</h3>
			<ul class="mt-3 space-y-2">
				{
					idiomas.map((idioma) => (
						<li class="text-sm">
							<span class="font-medium">{idioma.name}</span>
							<span class="text-muted"> · {idioma.level}</span>
							{idioma.note && <span class="block text-xs text-muted">{idioma.note}</span>}
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>