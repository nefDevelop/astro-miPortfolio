---
import { Image } from 'astro:assets';
import { ui, type Locale } from '../i18n/translations';
import { projects, otherProjects } from '../data/portfolio';
import { localePath } from '../lib/paths';
import PlateMarks from './PlateMarks.astro';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];
const list = projects[lang];
const extras = otherProjects[lang];
---

<section id="proyectos" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-20">
	<header class="max-w-prose" data-reveal>
		<h2 class="meta text-dot">{t.projects.title}</h2>
		<p class="mt-4 max-w-prose text-xl leading-relaxed sm:text-2xl">
			{t.projects.subtitle}
		</p>
	</header>

	{
		list.map((project, indice) => (
			<article class="mt-16 border-t border-hair pt-10" data-reveal>
				<div class="flex flex-col gap-2">
					<p class="meta">{project.type}</p>
					<h3 class="text-2xl font-bold tracking-tight sm:text-3xl" data-nav-label={`${project.title}${project.highlight}`}>
						{project.title}{project.highlight}
					</h3>
				</div>

				<p class="mt-4 max-w-prose text-lg leading-relaxed text-muted">{project.desc}</p>

				<ul class="mt-5 flex flex-wrap gap-2">
					{project.stack.map((tech) => (
						<li class="chip rounded-full border border-hair px-3 py-1.5 font-mono text-xs uppercase tracking-widest text-muted">
							{tech}
						</li>
					))}
				</ul>

				{/* Lámina: la captura enmarcada como una página de manual técnico */}
				<figure class="relative mt-8 border border-hair bg-surface p-2" data-plate>
					<PlateMarks seed={indice * 13} />
					<Image
						src={project.image}
						alt={project.imageAlt || project.title}
						width={1200}
						height={750}
						widths={[480, 800, 1200]}
						sizes="(min-width: 1024px) 640px, 100vw"
						loading={indice === 0 ? 'eager' : 'lazy'}
						fetchpriority={indice === 0 ? 'high' : undefined}
						class={`aspect-video w-full object-cover ${project.imagePosition || ''}`}
					/>
				</figure>

				<div class="mt-10 grid gap-10 sm:grid-cols-3">
					{project.slides.map((slide, s) => (
						<figure class="relative flex flex-col border border-hair bg-surface p-2" data-plate>
							<PlateMarks seed={s + 5} />
							<Image
								src={slide.image}
								alt={slide.imageAlt || slide.title}
								width={800}
								height={600}
								widths={[400, 800]}
								sizes="(min-width: 640px) 30vw, 100vw"
								loading="lazy"
								class={`aspect-[4/3] w-full object-cover ${slide.imagePosition || ''}`}
							/>
							<figcaption class="flex flex-1 flex-col gap-2 p-3">
								<h4 class="font-semibold">{slide.title}</h4>
								<p class="text-sm leading-relaxed text-muted">{slide.desc}</p>
								{slide.tags && (
									<ul class="mt-auto flex flex-wrap gap-2 pt-2">
										{slide.tags.map((tag) => (
											<li class="font-mono text-xs uppercase tracking-widest text-dot">{tag}</li>
										))}
									</ul>
								)}
							</figcaption>
						</figure>
					))}
				</div>

				{/* Los CTA cierran el artículo, tras la evidencia de las láminas:
				    el mismo patrón que la página de caso, que pone los botones
				    al final. */}
				<div class="mt-10 flex flex-wrap gap-3">
					<a
						href={localePath(lang, `projects/${project.slug}`)}
						class="rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-paper ink-btn"
					>
						{t.projects.caseStudy}
					</a>
					{project.demo && (
						<a
							href={project.demo}
							target="_blank"
							rel="noopener noreferrer"
							class="rounded-full border border-hair px-5 py-2.5 text-sm font-medium wash"
						>
							{t.projects.liveDemo}
						</a>
					)}
					{project.github && (
						<a
							href={project.github}
							target="_blank"
							rel="noopener noreferrer"
							class="rounded-full border border-hair px-5 py-2.5 text-sm font-medium wash"
						>
							{t.projects.viewRepo}
						</a>
					)}
				</div>
			</article>
		))
	}

	{
		/* Proyectos secundarios: tarjetas compactas en grid, sin caso de estudio.
		    Los stubs no traen enlaces, así que la tarjeta se queda en imagen +
		    texto hasta que se rellenen. */
		extras.length > 0 && (
			<div class="mt-20 border-t border-hair pt-10" data-reveal>
				<h3 class="meta text-dot">{t.projects.others}</h3>
				<div class="mt-8 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
					{extras.map((proyecto, i) => (
						<article class="flex flex-col">
							<figure class="relative border border-hair bg-surface p-2" data-plate>
								<PlateMarks seed={i + 21} />
								<Image
									src={proyecto.image}
									alt={proyecto.imageAlt || proyecto.title}
									width={800}
									height={600}
									widths={[400, 800]}
									sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw"
									loading="lazy"
									class={`aspect-video w-full object-cover ${proyecto.imagePosition || ''}`}
								/>
							</figure>
							<div class="mt-4 flex flex-1 flex-col gap-2">
								<p class="meta">{proyecto.type}</p>
								<h4 class="text-lg font-semibold tracking-tight">
									{proyecto.title}{proyecto.highlight}
								</h4>
								<p class="text-sm leading-relaxed text-muted">{proyecto.desc}</p>
								<ul class="mt-1 flex flex-wrap gap-2">
									{proyecto.stack.map((tech) => (
										<li class="chip rounded-full border border-hair px-2.5 py-1 font-mono text-xs uppercase tracking-widest text-muted">
											{tech}
										</li>
									))}
								</ul>
								{(proyecto.github || proyecto.demo) && (
									<div class="mt-auto flex flex-wrap gap-4 pt-3">
										{proyecto.demo && (
											<a
												href={proyecto.demo}
												target="_blank"
												rel="noopener noreferrer"
												class="link-underline text-sm"
											>
												{t.projects.liveDemo}
											</a>
										)}
										{proyecto.github && (
											<a
												href={proyecto.github}
												target="_blank"
												rel="noopener noreferrer"
												class="link-underline text-sm"
											>
												{t.projects.viewRepo}
											</a>
										)}
									</div>
								)}
							</div>
						</article>
					))}
				</div>
			</div>
		)
	}
</section>