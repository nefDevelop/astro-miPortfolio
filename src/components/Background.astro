---
import { ui, type Locale } from '../i18n/translations';
import { experience, education, certifications, type Entry } from '../data/portfolio';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];

// Un reclutador lee la trayectoria en este orden: experiencia, estudio y luego
// complementos. La experiencia ocupa dos columnas porque es lo que da contexto
// a quien cambia de sector; los otros dos caben en paralelo.
const blocks: { title: string; items: Entry[]; ancho?: boolean }[] = [
	{ title: t.background.jobs, items: experience[lang], ancho: true },
	{ title: t.background.education, items: education[lang] },
	{ title: t.background.certifications, items: certifications[lang] },
].filter((block) => block.items.length > 0);
---

<section id="trayectoria" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-20">
	{/* El reveal va en el envoltorio y no en el h2: el script del header atenúa
	    la opacidad de [data-nav-label] para que la etiqueta se recoja en la
	    barra. Si las dos cosas estuvieran en el mismo elemento, el estilo en
	    línea ganaría al reveal y el titular se vería antes de que se animara.
	    Al estar en capas distintas las opacidades se multiplican. */}
	<div data-reveal>
		<h2 class="meta text-dot" data-nav-label={t.nav.label.background}>{t.background.title}</h2>
	</div>

	<div class="mt-8 grid gap-12 md:grid-cols-2">
		{
			blocks.map((block) => (
				<div class:list={["border-t border-hair pt-6", block.ancho && "md:col-span-2"]} data-reveal>
					<h3 class="text-xl font-semibold">{block.title}</h3>
					<div class="mt-6 space-y-8">
						{block.items.map((item) => (
							<div>
								<h4 class="font-medium leading-snug">{item.title}</h4>
								<p class="meta mt-1.5">
									{item.place ? `${item.place} · ${item.period}` : item.period}
								</p>
								{item.desc && (
									<p class="mt-3 max-w-prose text-sm leading-relaxed text-muted">{item.desc}</p>
								)}
								{item.bullets && (
									<ul class="mt-3 max-w-prose space-y-2">
										{item.bullets.map((linea) => (
											<li class="flex gap-2.5 text-sm leading-relaxed text-muted">
												<span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-dot" aria-hidden="true" />
												{linea}
											</li>
										))}
									</ul>
								)}
							</div>
						))}
					</div>
				</div>
			))
		}
	</div>
</section>